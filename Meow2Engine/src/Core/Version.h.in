#pragma once

/// @file
/// @brief Engine version: the single source is `project(Meow2 VERSION x.y.z)` in the top-level `CMakeLists.txt`.
///
/// Generated by CMake from `Meow2Engine/src/Core/Version.h.in` at configure time. Do not edit the generated copy.
/// How the version changes is described in techstack.md §21.
/// @par Thread safety
/// Compile-time constants and a function returning a pointer to an immutable string; safe from any thread.

namespace Meow2
{
/// @brief MAJOR version: stays 0 until the public API is promised stable.
inline constexpr int c_versionMajor = @PROJECT_VERSION_MAJOR@;

/// @brief MINOR version: incremented once per milestone (M0 → 1, M1 → 2, …).
inline constexpr int c_versionMinor = @PROJECT_VERSION_MINOR@;

/// @brief PATCH version: incremented only for fixes to an already-released MINOR version.
inline constexpr int c_versionPatch = @PROJECT_VERSION_PATCH@;

/// @brief The whole version as `"MAJOR.MINOR.PATCH"`, e.g. `"0.1.0"`.
inline constexpr const char* c_versionString = "@PROJECT_VERSION@";

/// @brief Returns the version of the engine library that is actually linked into the program.
///
/// The `c_version*` constants are the version of the header the caller was **compiled against**. Comparing them with
/// this function detects a stale library (a program built against new headers but linked with an old library).
/// @return `"MAJOR.MINOR.PATCH"` of the linked library. Points to a string literal: never null, never freed.
const char* getVersionString();
} // namespace Meow2
