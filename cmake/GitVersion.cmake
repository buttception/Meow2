# Writes the build metadata of the engine version (techstack.md §21): "g<short hash>" plus ".dirty" when tracked
# files have local changes, or nothing when git or the repository isn't available (e.g. a source zip).
#
# Usage (script mode, run at build time by the meow2_git_version target):
#   cmake -DMEOW2_SOURCE_DIR=<repo> -DMEOW2_VERSION=<x.y.z> -DMEOW2_OUTPUT=<header> -P GitVersion.cmake
#
# The header is only rewritten when its content changes, so a build on the same commit recompiles nothing.

find_package(Git QUIET)

set(metadata "")
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
        WORKING_DIRECTORY "${MEOW2_SOURCE_DIR}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE hash
        ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    # rev-parse also succeeds in a parent repository; only accept the hash if MEOW2_SOURCE_DIR is the top level.
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --show-toplevel
        WORKING_DIRECTORY "${MEOW2_SOURCE_DIR}"
        OUTPUT_VARIABLE topLevel
        ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    get_filename_component(topLevel "${topLevel}" REALPATH)
    get_filename_component(sourceDir "${MEOW2_SOURCE_DIR}" REALPATH)
    if(result EQUAL 0 AND hash MATCHES "^[0-9a-f]+$" AND topLevel STREQUAL sourceDir)
        set(metadata "g${hash}")
        # Tracked files only (untracked ones, e.g. a local config, don't make a build "dirty"), and changes *inside*
        # submodules don't count either; a submodule moved to another commit does.
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no --ignore-submodules=dirty
            WORKING_DIRECTORY "${MEOW2_SOURCE_DIR}"
            OUTPUT_VARIABLE changes
            ERROR_QUIET
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT changes STREQUAL "")
            string(APPEND metadata ".dirty")
        endif()
    endif()
endif()

if(metadata STREQUAL "")
    set(fullVersion "${MEOW2_VERSION}")
else()
    set(fullVersion "${MEOW2_VERSION}+${metadata}")
endif()

set(content "// Generated by cmake/GitVersion.cmake at build time. Do not edit.
#pragma once

namespace Meow2::Detail
{
inline constexpr const char* c_buildMetadata = \"${metadata}\";
inline constexpr const char* c_fullVersionString = \"${fullVersion}\";
} // namespace Meow2::Detail
")

set(existing "")
if(EXISTS "${MEOW2_OUTPUT}")
    file(READ "${MEOW2_OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${MEOW2_OUTPUT}" "${content}")
endif()
