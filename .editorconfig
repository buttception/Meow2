# Basic text settings for every editor (Visual Studio, VS Code, Rider, ...).
# Kept in line with .clang-format (C++ layout) and .gitattributes (line endings).
# Checked by the Lint.EditorConfig.TextFilesFollowRules test. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows tool files are CRLF (see .gitattributes)
[*.{bat,cmd,ps1,sln,vcxproj,vcxproj.filters,props}]
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2

[.gitmodules]
# git itself writes this file with tabs
indent_style = tab
